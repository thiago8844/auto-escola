# Copie para .env.testing (ignorado pelo git) e preencha DB_PASSWORD com a senha do usuário
# da aplicação definida em infra/.env. Os testes usam apenas o banco autoescola_test.
APP_ENV=testing
APP_KEY=
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3322
DB_DATABASE=autoescola_test
DB_USERNAME=autoescola
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
