APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3322
DB_DATABASE=autoescola
DB_USERNAME=autoescola
DB_PASSWORD=

SESSION_DRIVER=database
# Domínios da SPA que recebem cookie de sessão do Sanctum (host[:porta], sem esquema).
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Origens completas (com esquema) autorizadas a chamar a API com cookie. Separe por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Tempo de vida dos tokens para o app mobile, em minutos (43200 = 30 dias).
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Frontend web (links de convite e verificação) e validade dos convites.
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_DAYS=7
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Desenvolvimento: Mailpit (infra/docker-compose.yml) captura os e-mails localmente, sem envio real.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responder@autoescola.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
AUTOESCOLA_TIMEZONE=America/Sao_Paulo

# Documentos privados (disco do filesystems.php e tamanho máximo do upload, em KB)
DOCUMENTS_DISK=local
DOCUMENT_MAX_KB=10240
